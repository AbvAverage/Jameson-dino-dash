// Cloudflare Workers config for Jameson's Dino Dash.
// Static site from public/, family score server at /api/board (a Durable Object, free plan).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jameson-dino-dash",
  "main": "worker/index.mjs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/game", "/game/"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "Board" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Board"] }],
  "observability": { "enabled": true }
}
